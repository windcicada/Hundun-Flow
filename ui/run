#!/usr/bin/env bash
# SPDX-License-Identifier: Apache-2.0
# Developed by WANG YUDONG | Email: wangyudong@buaa.edu.cn
set -euo pipefail

repo_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
port=${HUNDUN_UI_PORT:-8765}
usage() {
  cat <<'HELP'
用法：ui/run [--port 8765]

检查本地依赖、构建界面，并启动 http://127.0.0.1:端口。
环境变量 HUNDUN_UI_PORT 可设置默认端口；--port 优先。
算例、程序及状态目录配置参见 docs/ui.md。
HELP
}
while (($#)); do
  case "$1" in
    --port)
      if (($# < 2)); then
        printf '%s\n' '错误：--port 后需要端口号。' >&2
        exit 2
      fi
      port=$2
      shift 2
      ;;
    -h|--help) usage; exit 0 ;;
    *) printf '错误：未知参数 %s\n' "$1" >&2; usage >&2; exit 2 ;;
  esac
done
if [[ ! "$port" =~ ^[0-9]{1,5}$ ]] || ((10#$port < 1 || 10#$port > 65535)); then
  printf '%s\n' '错误：端口应为 1 至 65535 的整数。' >&2
  exit 2
fi
port=$((10#$port))
cd -- "$repo_dir"
python_bin="$repo_dir/ui/.venv/bin/python"
if [[ ! -x "$python_bin" ]]; then
  printf '%s\n' '需要 Python 3.11+ 虚拟环境。请在仓库根目录执行：' >&2
  printf '%s\n' '  python3.11 -m venv ui/.venv' '  ui/.venv/bin/python -m pip install -r ui/requirements.txt' >&2
  exit 1
fi
if ! "$python_bin" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 11) else 1)'; then
  printf '%s\n' '需要 Python 3.11+。请使用 python3.11 -m venv ui/.venv 建立环境。' >&2
  exit 1
fi
if ! "$python_bin" -c 'import fastapi, uvicorn, httpx, numpy, matplotlib, pyvista' >/dev/null 2>&1; then
  printf '%s\n' 'Python 依赖需要补齐，请执行：' '  ui/.venv/bin/python -m pip install -r ui/requirements.txt' >&2
  exit 1
fi
if ! command -v node >/dev/null 2>&1 || ! command -v npm >/dev/null 2>&1; then
  printf '%s\n' '需要 Node.js 20.19+（20.x）或 22.12+ 及 npm。' '若使用 nvm，请执行：nvm install 24 && nvm use 24' >&2
  exit 1
fi
if ! node -e 'const [major,minor]=process.versions.node.split(".").map(Number); process.exit((major===20&&minor>=19)||(major===22&&minor>=12)||major>22?0:1)'; then
  printf '%s\n' '当前 Node.js 版本需要更新。Vite 8 使用 Node.js 20.19+（20.x）或 22.12+。' '若使用 nvm，请执行：nvm install 24 && nvm use 24' >&2
  exit 1
fi
if [[ ! -x ui/node_modules/.bin/vite || ! -x ui/node_modules/.bin/tsc ]]; then
  printf '%s\n' '前端依赖需要补齐，请在仓库根目录执行：' '  npm ci --prefix ui' >&2
  exit 1
fi
npm run build --prefix ui
printf '\n工作台地址：http://127.0.0.1:%s\n' "$port"
printf '%s\n' 'Ctrl+C 结束界面服务；计算任务按各自生命周期运行。'
exec "$python_bin" -m uvicorn ui.backend:app --host 127.0.0.1 --port "$port" --workers 1
