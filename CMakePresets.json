{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "vendor": {
    "hundun-flow.org/spdx": {
      "SPDX-License-Identifier": "Apache-2.0"
    }
  },
  "configurePresets": [
    {
      "name": "debug",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "HUNDUN_BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "release",
      "displayName": "Clang Release with Cantera",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/b3",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_C_FLAGS": "-ffp-contract=off -flto=thin",
        "CMAKE_CXX_FLAGS": "-stdlib=libstdc++ -D_GLIBCXX_USE_CXX11_ABI=1 -ffp-contract=off -flto=thin",
        "CMAKE_EXE_LINKER_FLAGS": "-fuse-ld=lld",
        "CMAKE_SHARED_LINKER_FLAGS": "-fuse-ld=lld",
        "HUNDUN_BUILD_TESTS": "OFF",
        "HUNDUN_ENABLE_REACTING_CANTERA": "ON",
        "HUNDUN_CANTERA_PACKAGE_ROOT": "$env{HUNDUN_CANTERA_ROOT}"
      }
    },
    {
      "name": "asan",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/asan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "HUNDUN_BUILD_TESTS": "OFF",
        "HUNDUN_ENABLE_ASAN": "ON"
      }
    },
    {
      "name": "ubsan",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/ubsan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "HUNDUN_BUILD_TESTS": "OFF",
        "HUNDUN_ENABLE_UBSAN": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "configurePreset": "release",
      "targets": [
        "hundun"
      ]
    },
    {
      "name": "asan",
      "configurePreset": "asan"
    },
    {
      "name": "ubsan",
      "configurePreset": "ubsan"
    }
  ]
}
